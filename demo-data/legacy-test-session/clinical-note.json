      {
        "SectionName": "PLAN",
        "Summary": [
          {
            "EvidenceLinks": [
              {
                "SegmentId": "b1e3fdf9-5b09-4d23-bac0-4aee0cce7fb7"
              },
              {
                "SegmentId": "e0c63df6-f860-410b-8c31-a32ec0cdcea0"
              }
            ],
            "SummarizedSegment": "Anxiety:\n- Cognitive reframing: when experiencing the thought \"everyone can tell I'm not keeping up,\" patient will ask what evidence they actually have and remind themselves that a question is not proof of failure\n"
          },
          {
            "EvidenceLinks": [],
            "SummarizedSegment": "- Self-compassion practice: applying the same understanding to self as would to a friend (e.g., recognizing that one delayed draft does not erase all work done)\n"
          },
          {
            "EvidenceLinks": [
              {
                "SegmentId": "f46f7f66-73a1-49c9-b083-b9f7404a608c"
              }
            ],
            "SummarizedSegment": "- Intentional rest: scheduled 10-minute walks after lunch on Tuesdays and Thursdays without phone or headphones\n"
          },
          {
            "EvidenceLinks": [
              {
                "SegmentId": "f63bbc69-19cd-4e88-88be-2557c30416d6"
              },
              {
                "SegmentId": "219c90d0-80e6-4587-86f3-0acdfa362695"
              }
            ],
            "SummarizedSegment": "- Early warning sign recognition: when noticing shoulder tension or holding breath, patient will pause for two minutes, drink water, and check in with body needs (hunger, hydration)\n"
          },
          {
            "EvidenceLinks": [
              {
                "SegmentId": "9f355c88-7407-454b-8bad-4c1c6843eedc"
              },
              {
                "SegmentId": "1254fefd-8a45-4600-b3c7-29390a04bb6c"
              },
              {
                "SegmentId": "b899c219-1044-4346-9ee8-56600d0ce55f"
              }
            ],
            "SummarizedSegment": "- Communication strategy: when work becomes intense, patient will pause before working through dinner, check in with body, and send a realistic update instead of silently panicking\n"
          },
          {
            "EvidenceLinks": [
              {
                "SegmentId": "998a24d2-9179-4449-be63-398e59b0aee7"
              },
              {
                "SegmentId": "e097d0ee-2b4e-4f18-acb8-ece367409ac4"
              }
            ],
            "SummarizedSegment": "- Discussed the concept of intentional rest and its benefits\n"
          },
          {
            "EvidenceLinks": [
              {
                "SegmentId": "b5224aa1-cd20-4a40-8065-cd65dbb7fdcc"
              }
            ],
            "SummarizedSegment": "- Explored the difference between productive work and counterproductive \"pushing harder\" when anxious\n"
          },
          {
            "EvidenceLinks": [
              {
                "SegmentId": "13e0b033-5771-47a2-964e-78a5f4b5430a"
              }
            ],
            "SummarizedSegment": "- Encouraged patient to notice early physical warning signs of stress rather than waiting until feeling \"terrible\"\n"
          },
          {
            "EvidenceLinks": [
              {
                "SegmentId": "285d1c9b-32b6-4d51-9ea7-c808ae99ac90"
              },
              {
                "SegmentId": "e0c63df6-f860-410b-8c31-a32ec0cdcea0"
              }
            ],
            "SummarizedSegment": "- Reinforced that the goal is to notice signals and practice a more balanced response, not to respond perfectly every time\n"
          },
          {
            "EvidenceLinks": [
              {
                "SegmentId": "6dd68170-9b13-4eb1-9987-0ff27c044b66"
              },
              {
                "SegmentId": "23b754f1-b415-4cee-928c-c2087979ed05"
              }
            ],
            "SummarizedSegment": "- Review patient's progress with new strategies at next session and adjust plan as needed\n"
          }
        ]
      }

              }
            ],
            "SummarizedSegment": "The patient realized their internal alarm is often louder than the actual situation."
          },
          {
            "EvidenceLinks": [
              {
                "SegmentId": "63b9bc62-d4d9-4cb0-a5aa-e59a0e8e8332"
              },
              {
                "SegmentId": "27ae6ae9-3f29-49d7-8e05-f9829ab6c52c"
              }
            ],
            "SummarizedSegment": "They were able to finish the urgent case, leave work before 7 PM, and have dinner with their partner Nora."
          },
          {
            "EvidenceLinks": [
              {
                "SegmentId": "4175bdf8-0204-4ac0-a0de-48e6b2750c6c"
              },
              {
                "SegmentId": "6477518e-43fd-43b1-8e43-6d83bcf0a338"
              }
            ],
            "SummarizedSegment": "The patient checked their phone twice during dinner but did not open their laptop.\n"
          },
          {
            "EvidenceLinks": [
              {
                "SegmentId": "c7b008e3-5f95-4c55-beee-3bea4d83cf84"
              },
              {
                "SegmentId": "fcda9d71-365a-4efc-bb87-40b2bb5744c8"

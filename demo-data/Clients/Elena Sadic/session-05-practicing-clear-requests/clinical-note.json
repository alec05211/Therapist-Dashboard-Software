              },
              {
                "SegmentId": "5acae2e9-377e-4c56-88f7-e52f660b194e"
              }
            ],
            "SummarizedSegment": "They describe a recent incident where their supervisor helped with launch tasks, and the patient almost volunteered for another committee out of a sense of obligation."
          },
          {
            "EvidenceLinks": [
              {
                "SegmentId": "ab60c00d-32c7-424c-9951-ca40f05755aa"
              },
              {
                "SegmentId": "3a9aaf29-cc4f-4539-b9cc-eb44209e6f31"

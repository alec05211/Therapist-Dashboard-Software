              },
              {
                "SegmentId": "0df1d4de-ccb6-4e77-a2e1-74b764e8bb51"
              }
            ],
            "SummarizedSegment": "The patient stopped themselves by asking whether they actually had time, and when they declined, the supervisor responded that it made sense.\n"
          },
          {
            "EvidenceLinks": [
              {
                "SegmentId": "0cfa5a56-3c70-46b9-ac9f-a3cb9ff57b0e"
              },
              {
                "SegmentId": "ae603aa2-7d8d-4cf2-9da9-30b83387581d"

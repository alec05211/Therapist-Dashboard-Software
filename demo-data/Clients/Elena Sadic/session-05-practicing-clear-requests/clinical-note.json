              },
              {
                "SegmentId": "8865d717-ac3e-4c9f-8a82-87feaa0e8b1f"
              }
            ],
            "SummarizedSegment": "The patient reflects on their father, who also did not like asking for help and would say he was fine when clearly uncomfortable."
          },
          {
            "EvidenceLinks": [
              {
                "SegmentId": "72446943-ef88-4d1e-a018-f1fb18e1b35b"
              },
              {
                "SegmentId": "9377e126-e90a-4124-b98b-e7a8ad41c732"
              }
            ],
            "SummarizedSegment": "The patient does not want to become someone who only reaches out when things are unbearable.\n"
          }

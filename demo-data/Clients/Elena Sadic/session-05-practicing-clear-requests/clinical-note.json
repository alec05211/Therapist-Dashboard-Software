              {
                "SegmentId": "77c243ca-0a3b-4fcc-a837-13a18300469c"
              },
              {
                "SegmentId": "6b4c0846-53e8-4d6d-b889-32b585dd05b6"
              }
            ],
            "SummarizedSegment": "They plan to text their sister tonight to ask if she has time to talk this weekend, without making it sound like an emergency."
          },
          {
            "EvidenceLinks": [
              {
                "SegmentId": "b7a07271-6ff0-494c-90dd-d7343121373c"
              },
              {
                "SegmentId": "30487c60-0ad5-49b8-af9a-680771fbefd8"
              },
              {
                "SegmentId": "552811d7-958a-4153-91e5-a2e678ab1a50"
              }
            ],
            "SummarizedSegment": "The patient had a 20-minute call with their sister and felt closer afterward, though they experienced guilt later that night."
          },
          {
            "EvidenceLinks": [
              {
                "SegmentId": "08f845a0-a2b4-49fe-b00e-a0aba3e7bb6c"
              },
              {
                "SegmentId": "4e86576e-810d-407d-ab59-0efb84070464"

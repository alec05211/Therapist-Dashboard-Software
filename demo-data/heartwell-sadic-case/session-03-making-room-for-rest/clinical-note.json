                "SegmentId": "69aeeef3-dcbf-4313-b216-d81b4fa8969b"
              }
            ],
            "SummarizedSegment": "On Friday, the patient experienced a more challenging situation with an upset client."
          },
          {
            "EvidenceLinks": [
              {
                "SegmentId": "69aeeef3-dcbf-4313-b216-d81b4fa8969b"
              },
              {
                "SegmentId": "04cad02b-8de6-4f81-b362-a0e1e982e919"

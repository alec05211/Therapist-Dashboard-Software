              }
            ],
            "SummarizedSegment": "The patient attempted to leave work on time on Tuesday but was interrupted by an email from an upset client about a hearing date."
          },
          {
            "EvidenceLinks": [
              {
                "SegmentId": "ebb6ba1c-1186-4155-b610-ac0477448311"

                "SegmentId": "1c3d2ad2-e924-4d15-be14-09b86c294159"
              }
            ],
            "SummarizedSegment": "The patient felt that leaving would mean they did not care, and they researched everything again to try to make the fear go away for both themselves and the client."
          },
          {
            "EvidenceLinks": [
              {
                "SegmentId": "e2eb8a44-1d9d-4f02-91c8-b1c19cdcb68f"
              },
              {
                "SegmentId": "7094bbfc-06b3-4337-bd37-14ce7d87b885"
              }

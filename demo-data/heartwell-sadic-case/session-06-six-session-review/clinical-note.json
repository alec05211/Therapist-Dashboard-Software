              }
            ],
            "SummarizedSegment": "A project launch is scheduled for next month, which the patient is excited about but also nervous."
          },
          {
            "EvidenceLinks": [
              {
                "SegmentId": "f005f582-8554-4e44-9bd5-d5b0939ab79f"

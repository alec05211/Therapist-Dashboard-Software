              },
              {
                "SegmentId": "33f0d021-c946-4995-98d8-efc3ba2ef2da"
              }
            ],
            "SummarizedSegment": "The patient continues to struggle with feeling guilty when resting and difficulty accepting care from others without feeling obligated."
          },
          {
            "EvidenceLinks": [
              {
                "SegmentId": "d771b508-517b-4115-a111-17528bb75313"
              }
            ],
            "SummarizedSegment": "They express a desire to explore their relationship with their father, believing it contributed to their current patterns.\n"
          }

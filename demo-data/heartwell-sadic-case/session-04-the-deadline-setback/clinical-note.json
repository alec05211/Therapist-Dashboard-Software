              {
                "SegmentId": "cb33537a-00e7-48c1-85f0-74a8d8706224"
              },
              {
                "SegmentId": "0e22df9f-c38a-4d64-b374-6dd5b02a1314"
              }
            ],
            "SummarizedSegment": "Regarding self-harm thoughts, the patient reports they came up one night after getting home late, with thoughts about not wanting to deal with anything anymore."
          },
          {
            "EvidenceLinks": [
              {
                "SegmentId": "4a3f18b7-e510-4105-9e1e-a8faa449f157"
              },
              {
                "SegmentId": "77bcbe96-f1e7-4c84-9823-eb289aa6f4ca"
              },
              {
                "SegmentId": "cb33537a-00e7-48c1-85f0-74a8d8706224"
              },
              {
                "SegmentId": "0e22df9f-c38a-4d64-b374-6dd5b02a1314"
              }
            ],
            "SummarizedSegment": "They describe feeling scared by these thoughts but did not have a plan or intent to act on them."
          },
          {
            "EvidenceLinks": [
              {
                "SegmentId": "4a3f18b7-e510-4105-9e1e-a8faa449f157"
              },
              {
                "SegmentId": "77bcbe96-f1e7-4c84-9823-eb289aa6f4ca"

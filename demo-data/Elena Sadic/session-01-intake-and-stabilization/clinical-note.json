              }
            ],
            "SummarizedSegment": "They work in legal aid and describe feeling constantly overwhelmed, either working, thinking about work, or feeling guilty about not working."
          },
          {
            "EvidenceLinks": [
              {
                "SegmentId": "58cd7b42-fb38-4bc2-8233-36eb4338b242"
              }
            ],
            "SummarizedSegment": "The patient reports being tired all the time but feeling restless when trying to rest."
          },
          {
            "EvidenceLinks": [
              {
                "SegmentId": "fc74bf7f-b248-4ec9-943b-8a28421f9705"
              },
              {
                "SegmentId": "b9a9f20b-519c-4d03-9eab-7c1e2286e203"
              }
            ],
            "SummarizedSegment": "They stay up late trying to get ahead but do not actually get ahead, often rereading the same document or rearranging lists."
          },
          {
            "EvidenceLinks": [
              {
                "SegmentId": "483901d4-045b-4067-9a3b-adad736f1850"
              }
            ],
            "SummarizedSegment": "Some nights they sleep 5 hours, some nights more."
          },
          {
            "EvidenceLinks": [
              {
                "SegmentId": "ce1beaf5-6c67-4427-bb19-08e229c423c9"
              }
            ],
            "SummarizedSegment": "The patient skips lunch when anxious about deadlines."
          },
          {
            "EvidenceLinks": [
              {
                "SegmentId": "b0794105-c620-48b5-ac02-b4a358fb435e"
              },
              {
                "SegmentId": "ad5d6c05-ee94-43c7-921f-4bd03cf55428"
              }
            ],
            "SummarizedSegment": "They used to see friends on Sundays but now cancel plans because they cannot imagine having a conversation.\n"
          },
          {
            "EvidenceLinks": [
              {
                "SegmentId": "75deb882-e6f5-4b25-ba89-f61fb7a7f45c"
              },
              {
                "SegmentId": "4d09ca79-5252-4423-b85e-a59fc12a3b95"

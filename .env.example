# Non-secret local settings for the synthetic demo RDS.
# Keep DATABASE_URL and every password out of this file.
AWS_PROFILE=terraform
AWS_REGION=us-east-1
HEALTHSCRIBE_MAX_SPEAKERS=6
DATABASE_SECRET_ARN=replace-with-rds-managed-secret-arn
DATABASE_HOST=replace-with-rds-endpoint
DATABASE_NAME=therapist_dashboard
# Enable only after provisioning and registering organization storage.
ORGANIZATION_STORAGE_ENABLED=false
# When both an OpenAI key and proposal model are configured, every completed
# transcript upload is automatically analyzed regardless of account type.
JOURNEY_PROPOSAL_MODEL=
# Configuring both models plus OPENAI_API_KEY enables queued synthesis for every
# eligible client. Set the worker flag false to pause dispatch deployment-wide.
INSIGHTS_MODEL=
PRE_SESSION_MODEL=
CLINICAL_SYNTHESIS_WORKER_ENABLED=true
# Omit the model or API key to keep analysis blocked. Do not configure this for
# real clinical data until the provider data flow and contractual, retention,
# privacy, security, consent, and clinical-policy controls are approved.

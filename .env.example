# Non-secret local settings for the synthetic demo RDS.
# Keep DATABASE_URL and every password out of this file.
AWS_PROFILE=terraform
AWS_REGION=us-east-1
DATABASE_SECRET_ARN=replace-with-rds-managed-secret-arn
DATABASE_HOST=replace-with-rds-endpoint
DATABASE_NAME=therapist_dashboard
# Enable only after provisioning and registering organization storage.
ORGANIZATION_STORAGE_ENABLED=false

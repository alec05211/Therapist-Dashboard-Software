#!/bin/bash
set -euo pipefail

dnf install -y docker git
systemctl enable --now docker
systemctl enable --now amazon-ssm-agent
usermod -aG docker ec2-user

# Keep the small initial instance usable during container image builds. The
# swapfile lives on the encrypted root volume and contains synthetic-demo data
# only; it is destroyed with the application stack.
if [[ ! -f /swapfile ]]; then
  fallocate -l 2G /swapfile
  chmod 0600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >>/etc/fstab
fi

install -d -m 0755 /etc/caddy /etc/therapist-dashboard /opt/therapist-dashboard

cat >/etc/caddy/Caddyfile <<'CADDYFILE'
${domain_name} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=86400"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(self)"
    }

    handle /infra-healthz {
        respond "ok" 200
    }

    reverse_proxy 127.0.0.1:3000
}
CADDYFILE

# This file contains identifiers only. Runtime secrets must be installed through
# the documented SSM workflow and must never be placed in Terraform/user data.
cat >/etc/therapist-dashboard/runtime-identifiers.env <<'RUNTIMEVARS'
AWS_REGION=${aws_region}
DATABASE_HOST=${database_endpoint}
DATABASE_NAME=${database_name}
DATABASE_SECRET_ARN=${database_secret_arn}
HEALTHSCRIBE_INPUT_BUCKET=${healthscribe_input_bucket}
HEALTHSCRIBE_OUTPUT_BUCKET=${healthscribe_output_bucket}
HEALTHSCRIBE_BATCH_DATA_ACCESS_ROLE_ARN=${healthscribe_batch_data_access_role_arn}
API_ORIGIN=http://127.0.0.1:8000
APP_BASE_URL=https://${domain_name}
RUNTIMEVARS
chmod 0640 /etc/therapist-dashboard/runtime-identifiers.env
chown root:ec2-user /etc/therapist-dashboard/runtime-identifiers.env

docker volume create caddy_data
docker volume create caddy_config
docker rm -f caddy >/dev/null 2>&1 || true
docker run -d \
  --name caddy \
  --restart unless-stopped \
  --network host \
  -v /etc/caddy/Caddyfile:/etc/caddy/Caddyfile:ro \
  -v caddy_data:/data \
  -v caddy_config:/config \
  caddy:2.10-alpine
